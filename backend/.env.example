# Backend Environment Variables
PORT=3000
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/careers?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
RESUME_ENCRYPTION_KEY=your_32_byte_base64_or_64_hex_key_here
CORS_ORIGIN=http://localhost:3001,https://your-frontend.vercel.app
# Optional: PKI for JWT and Audit Logs
# JWT_PRIVATE_KEY=...
# JWT_PUBLIC_KEY=...
# AUDIT_LOG_PRIVATE_KEY=...
# AUDIT_LOG_PUBLIC_KEY=...
